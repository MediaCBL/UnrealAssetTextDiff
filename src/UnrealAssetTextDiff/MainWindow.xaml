<Window x:Class="UnrealAssetTextDiff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unreal Asset Text Diff" Width="880" Height="640" MinWidth="700" MinHeight="520">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Configuration" Grid.Row="0" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="_Project (.uproject):" Grid.Row="0" Target="{Binding ElementName=ProjectBox}"/>
                <TextBox x:Name="ProjectBox" Grid.Row="0" Grid.Column="1" Margin="2"
                         AutomationProperties.Name="Project file path" AllowDrop="True"/>
                <Button Content="Browse..." Grid.Row="0" Grid.Column="2" Margin="2" Padding="8,0"
                        Click="BrowseProject" AutomationProperties.Name="Browse for project"/>
                <Label Content="_UnrealEditor-Cmd.exe:" Grid.Row="1" Target="{Binding ElementName=EngineBox}"/>
                <TextBox x:Name="EngineBox" Grid.Row="1" Grid.Column="1" Margin="2"
                         AutomationProperties.Name="UnrealEditor commandlet executable path" AllowDrop="True"/>
                <Button Content="Browse..." Grid.Row="1" Grid.Column="2" Margin="2" Padding="8,0"
                        Click="BrowseEngine" AutomationProperties.Name="Browse for engine"/>
                <Label Content="_TortoiseMerge.exe:" Grid.Row="2" Target="{Binding ElementName=TortoiseBox}"/>
                <TextBox x:Name="TortoiseBox" Grid.Row="2" Grid.Column="1" Margin="2"
                         AutomationProperties.Name="TortoiseMerge executable path" AllowDrop="True"/>
                <Button Content="Browse..." Grid.Row="2" Grid.Column="2" Margin="2" Padding="8,0"
                        Click="BrowseTortoise" AutomationProperties.Name="Browse for TortoiseMerge"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Assets (drop .uasset files onto the fields)" Grid.Row="1" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="_Base (old):" Grid.Row="0" Target="{Binding ElementName=BaseBox}"/>
                <TextBox x:Name="BaseBox" Grid.Row="0" Grid.Column="1" Margin="2"
                         AutomationProperties.Name="Base or old asset file" AllowDrop="True"/>
                <Button Content="Browse..." Grid.Row="0" Grid.Column="2" Margin="2" Padding="8,0"
                        Click="BrowseBase" AutomationProperties.Name="Browse for base asset"/>
                <Label Content="Label:" Grid.Row="0" Grid.Column="3" Target="{Binding ElementName=BaseLabelBox}"/>
                <TextBox x:Name="BaseLabelBox" Grid.Row="0" Grid.Column="4" Margin="2"
                         AutomationProperties.Name="Base revision label"/>

                <Label Content="_Mine (new):" Grid.Row="1" Target="{Binding ElementName=MineBox}"/>
                <TextBox x:Name="MineBox" Grid.Row="1" Grid.Column="1" Margin="2"
                         AutomationProperties.Name="Mine or new asset file" AllowDrop="True"/>
                <Button Content="Browse..." Grid.Row="1" Grid.Column="2" Margin="2" Padding="8,0"
                        Click="BrowseMine" AutomationProperties.Name="Browse for mine asset"/>
                <Label Content="Label:" Grid.Row="1" Grid.Column="3" Target="{Binding ElementName=MineLabelBox}"/>
                <TextBox x:Name="MineLabelBox" Grid.Row="1" Grid.Column="4" Margin="2"
                         AutomationProperties.Name="Mine revision label"/>

                <Button x:Name="SwapButton" Content="_Swap sides" Grid.Row="2" Grid.Column="1" Margin="2" Padding="12,2"
                        HorizontalAlignment="Left" Click="SwapSides"
                        AutomationProperties.Name="Swap base and mine assets"/>
                <CheckBox x:Name="FilteredCheck" Grid.Row="2" Grid.Column="4" VerticalAlignment="Center"
                          Content="_Filtered view" Margin="4,0"
                          ToolTip="Opt-in: additionally normalize per-load identifier noise (generated graphs, PinIds, localization keys inside generated objects). Off: only the staged package name is normalized. Raw exports are always kept."
                          AutomationProperties.Name="Filtered view (normalize generated identifiers)"/>
            </Grid>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,6">
            <Button x:Name="CompareButton" Content="_Compare" Padding="16,4" Margin="0,0,6,0"
                    Click="CompareClick" AutomationProperties.Name="Compare assets in TortoiseMerge"/>
            <Button x:Name="ExportOnlyButton" Content="_Export text only" Padding="16,4" Margin="0,0,6,0"
                    Click="ExportOnlyClick" AutomationProperties.Name="Export text only"/>
            <Button x:Name="OpenFolderButton" Content="_Open output folder" Padding="16,4" Margin="0,0,6,0"
                    Click="OpenFolderClick" IsEnabled="False"
                    AutomationProperties.Name="Open output folder"/>
            <Button x:Name="CancelButton" Content="Canc_el" Padding="16,4" Click="CancelClick"
                    IsEnabled="False" AutomationProperties.Name="Cancel running operation"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" Height="6" IsIndeterminate="False" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                       Text="Ready" AutomationProperties.LiveSetting="Polite"/>
        </Grid>

        <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                 TextWrapping="Wrap" AutomationProperties.Name="Diagnostic log"/>

        <StatusBar Grid.Row="5" Margin="-8,-4,-8,-8">
            <StatusBarItem>
                <TextBlock Text="Text exports are read-only inspection copies; merging back into .uasset is not supported."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
